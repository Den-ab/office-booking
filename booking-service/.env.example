# Used when running the service outside Docker (e.g. from the IDE).
# Postgres settings
POSTGRES_URL=jdbc:postgresql://localhost:5434/office_booking?characterEncoding=UTF8
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost

# Security: HS256 needs a secret of at least 32 bytes
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
JWT_EXPIRATION=86400000

# Sender address shown in booking emails
EMAIL_SENDER=no-reply@example.com
