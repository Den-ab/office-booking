# Used when running the service outside Docker (e.g. from the IDE).
SERVER_PORT=9011

# RabbitMQ settings
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# SMTP settings (Mailpit from compose.yaml accepts any credentials)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=demo
MAIL_PASSWORD=demo

# Application-specific settings
EMAIL_TEMPLATES_PATH=email/
EMAIL_SENDER_ADDRESS=no-reply@example.com
LOGO_PATH=images/logo.png
LOCALE=ru-RU
